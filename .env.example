# WatchWeaver configuration
# This file is optional. Normal integration setup is performed in the UI.
# Values supplied here override and lock their corresponding UI fields.
# Never commit a populated .env file.

WATCHWEAVER_LISTEN_ADDR=:8080
WATCHWEAVER_PORT=8080
TZ=UTC

TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
DISCORD_WEBHOOK_URL=

DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

WATCHWEAVER_DATABASE=/data/watchweaver.db
